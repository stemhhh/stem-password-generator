<UserControl
    x:Class="StemPasswordGenerator.Views.VaultPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:StemPasswordGenerator.Views"
    xmlns:models="using:StemPasswordGenerator.Models"
    xmlns:vm="using:StemPasswordGenerator.ViewModels">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <views:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer
            views:FluidPage.Enable="True"
            Visibility="{Binding ShowSetup, Converter={StaticResource BoolToVisibilityConverter}}"
            Padding="24,18,28,24">
            <StackPanel MaxWidth="560" Spacing="16" HorizontalAlignment="Center">
                <TextBlock Text="{Binding [CreateVaultTitle], Source={StaticResource Loc}}" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock
                    Text="{Binding PeopleWarning}"
                    Style="{StaticResource SecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <ComboBox
                    Header="{Binding [PersonOnPc], Source={StaticResource Loc}}"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Occupants}"
                    DisplayMemberPath="DisplayName"
                    SelectedItem="{Binding SelectedOccupant, Mode=TwoWay}" />
                <TextBox
                    Header="{Binding [NameForVault], Source={StaticResource Loc}}"
                    PlaceholderText="{Binding [NameForVaultHint], Source={StaticResource Loc}}"
                    Text="{Binding NewPersonName, Mode=TwoWay}" />
                <TextBlock
                    Text="{Binding [CreateVaultHint], Source={StaticResource Loc}}"
                    Style="{StaticResource SecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <PasswordBox
                    x:Name="SetupPasswordBox"
                    Header="{Binding [MasterPasswordHeader], Source={StaticResource Loc}}"
                    PasswordChanged="SetupPasswordBox_PasswordChanged"
                    PasswordRevealMode="Peek" />
                <PasswordBox
                    x:Name="SetupConfirmBox"
                    Header="{Binding [ConfirmMasterPassword], Source={StaticResource Loc}}"
                    PasswordChanged="SetupConfirmBox_PasswordChanged"
                    PasswordRevealMode="Peek" />
                <Button
                    Content="{Binding [CreateEncryptedVault], Source={StaticResource Loc}}"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    MinHeight="44"
                    Command="{Binding CreateVaultCommand}" />
                <Button
                    Content="{Binding [PortableOpenButton], Source={StaticResource Loc}}"
                    HorizontalAlignment="Stretch"
                    MinHeight="44"
                    Command="{Binding OpenPortableCommand}" />
                <TextBlock
                    Text="{Binding [PortableOpenHow], Source={StaticResource Loc}}"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="Wrap" />
                <ProgressRing IsActive="{Binding IsBusy}" Width="28" Height="28" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer
            views:FluidPage.Enable="True"
            Visibility="{Binding ShowUnlock, Converter={StaticResource BoolToVisibilityConverter}}"
            Padding="24,18,28,24">
            <StackPanel MaxWidth="640" Spacing="16" HorizontalAlignment="Center">
                <TextBlock Text="{Binding [UnlockVault], Source={StaticResource Loc}}" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{Binding CurrentPersonLabel}" Style="{StaticResource CardTitleStyle}" />
                <TextBlock
                    Text="{Binding PeopleWarning}"
                    Style="{StaticResource SecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <ComboBox
                    Header="{Binding [WhoIsUnlocking], Source={StaticResource Loc}}"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Occupants}"
                    DisplayMemberPath="DisplayName"
                    SelectedItem="{Binding SelectedOccupant, Mode=TwoWay}" />
                <TextBlock
                    Text="{Binding SwitchWarning}"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="Wrap" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Header="{Binding [AddAnotherPerson], Source={StaticResource Loc}}"
                        PlaceholderText="{Binding [PartnerRoommate], Source={StaticResource Loc}}"
                        Text="{Binding NewPersonName, Mode=TwoWay}" />
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Content="{Binding [Add], Source={StaticResource Loc}}"
                        Command="{Binding AddPersonCommand}" />
                </Grid>
                <TextBlock
                    Text="{Binding [UnlockHint], Source={StaticResource Loc}}"
                    Style="{StaticResource SecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <PasswordBox
                    x:Name="UnlockPasswordBox"
                    Header="{Binding [MasterPassword], Source={StaticResource Loc}}"
                    PasswordChanged="UnlockPasswordBox_PasswordChanged"
                    PasswordRevealMode="Peek" />
                <CheckBox
                    Content="{Binding [UseOnScreenKeyboard], Source={StaticResource Loc}}"
                    IsChecked="{Binding UseMasterKeyboard, Mode=TwoWay}"
                    MinHeight="40" />
                <TextBlock
                    Text="{Binding [MasterKeyboardHint], Source={StaticResource Loc}}"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="Wrap"
                    Visibility="{Binding UseMasterKeyboard, Converter={StaticResource BoolToVisibilityConverter}}" />
                <views:MasterKeyboardView
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding UseMasterKeyboard, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0,4,0,0" />
                <Button
                    Content="{Binding [Unlock], Source={StaticResource Loc}}"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    MinHeight="44"
                    Command="{Binding UnlockCommand}" />
                <Button
                    Content="{Binding [ForgotMaster], Source={StaticResource Loc}}"
                    HorizontalAlignment="Stretch"
                    MinHeight="44"
                    Command="{Binding ForgotMasterCommand}"
                    Visibility="{Binding RecoveryConfigured, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock
                    Text="{Binding [ForgotMasterBody], Source={StaticResource Loc}}"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="Wrap"
                    Visibility="{Binding RecoveryConfigured, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button
                    Content="{Binding [ShamirRecoverButton], Source={StaticResource Loc}}"
                    HorizontalAlignment="Stretch"
                    MinHeight="44"
                    Command="{Binding RecoverShamirCommand}" />
                <TextBlock
                    Text="{Binding [ShamirRecoverHint], Source={StaticResource Loc}}"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{Binding HelloWarning}"
                    Style="{StaticResource CaptionTextStyle}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasSeveralPeople, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
                        Content="{Binding [UnlockHello], Source={StaticResource Loc}}"
                        HorizontalAlignment="Stretch"
                        MinHeight="44"
                        Command="{Binding UnlockWithHelloCommand}"
                        Visibility="{Binding HelloAvailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
                        Content="{Binding [UnlockUsb], Source={StaticResource Loc}}"
                        HorizontalAlignment="Stretch"
                        MinHeight="44"
                        Command="{Binding UnlockWithUsbCommand}"
                        Visibility="{Binding UsbUnlockAvailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button
                        Content="{Binding [PanicLock], Source={StaticResource Loc}}"
                        HorizontalAlignment="Stretch"
                        MinHeight="44"
                        Command="{Binding PanicLockCommand}" />
                    <TextBlock
                        Text="{Binding [PanicLockShortcut], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}" />
                <ProgressRing IsActive="{Binding IsBusy}" Width="28" Height="28" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer
            views:FluidPage.Enable="True"
            Visibility="{Binding ShowHumanVerification, Converter={StaticResource BoolToVisibilityConverter}}"
            Padding="24,18,28,24">
            <StackPanel MaxWidth="420" Spacing="16" HorizontalAlignment="Center">
                <TextBlock Text="{Binding HumanVerificationHeading}" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock
                    Text="{Binding HumanVerificationDetail}"
                    Style="{StaticResource SecondaryTextStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{Binding HumanChallengeText}"
                    FontSize="28"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    IsTextSelectionEnabled="False" />
                <ItemsRepeater
                    ItemsSource="{Binding HumanKeypad}"
                    HorizontalAlignment="Stretch"
                    MaxWidth="280">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="72"
                            MinItemHeight="56"
                            MinRowSpacing="8"
                            MinColumnSpacing="8"
                            MaximumRowsOrColumns="3"
                            ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Content="{Binding}"
                                Click="HumanKey_Click"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinHeight="56"
                                FontSize="20"
                                FontWeight="SemiBold" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Button
                    Content="{Binding [HumanVerificationCancel], Source={StaticResource Loc}}"
                    Command="{Binding CancelHumanVerificationCommand}"
                    HorizontalAlignment="Stretch"
                    MinHeight="44" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid Visibility="{Binding ShowWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar
                IsOpen="{Binding ShowDecoyBanner, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False"
                Title="{Binding [EditingDecoyTitle], Source={StaticResource Loc}}"
                Message="{Binding [EditingDecoyBody], Source={StaticResource Loc}}" />
            <Grid x:Name="WorkspaceSplit" Grid.Row="1" SizeChanged="WorkspaceSplit_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="VaultListColumn" Width="0.9*" MinWidth="220" MaxWidth="520" />
                <ColumnDefinition x:Name="VaultEditorColumn" Width="2.2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="VaultListRow" Height="*" />
                <RowDefinition x:Name="VaultEditorRow" Height="0" />
            </Grid.RowDefinitions>

            <Border
                x:Name="VaultListPane"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        PlaceholderText="{Binding [SearchVault], Source={StaticResource Loc}}"
                        Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        UseSystemFocusVisuals="True" />
                    <TextBlock
                        Grid.Row="1"
                        Text="{Binding VaultWorkspaceTitle}"
                        Style="{StaticResource CardTitleStyle}" />
                    <ComboBox
                        Grid.Row="2"
                        Header="{Binding FolderFilterHeader}"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding FolderFilters}"
                        DisplayMemberPath="Label"
                        SelectedItem="{Binding SelectedFolderFilter, Mode=TwoWay}"
                        Visibility="{Binding ShowFolderFilter, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ComboBox
                        Grid.Row="2"
                        Header="{Binding [AuditFilter], Source={StaticResource Loc}}"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AuditFilters}"
                        DisplayMemberPath="Label"
                        SelectedItem="{Binding SelectedAuditFilter, Mode=TwoWay}"
                        Visibility="{Binding ShowAuditSection, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <StackPanel
                        Grid.Row="3"
                        Spacing="8"
                        Visibility="{Binding ShowLoginSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button
                        Content="{Binding [NewLogin], Source={StaticResource Loc}}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding NewLoginCommand}" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding [KindAlias], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" Command="{Binding NewAliasCommand}" />
                        <Button Grid.Column="1" Content="{Binding [KindCard], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" Command="{Binding NewCardCommand}" />
                        <Button Grid.Column="2" Content="{Binding [KindNote], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" Command="{Binding NewNoteCommand}" />
                    </Grid>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding [KindRecovery], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" Command="{Binding NewRecoveryCommand}" />
                        <Button Grid.Column="1" Content="{Binding [KindWifi], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" Command="{Binding NewWifiCommand}" />
                        <Button Grid.Column="2" Content="{Binding [KindSecret], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" Command="{Binding NewSecretCommand}" />
                    </Grid>
                    </StackPanel>
                    <StackPanel
                        Grid.Row="3"
                        Spacing="8"
                        Visibility="{Binding ShowMediaEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ComboBox
                        Header="{Binding [MediaSort], Source={StaticResource Loc}}"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding MediaSortChoices}"
                        DisplayMemberPath="Label"
                        SelectedItem="{Binding SelectedMediaSort, Mode=TwoWay}" />
                    <Button
                        Content="{Binding MediaAddCurrentLabel}"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Command="{Binding AddCurrentMediaCommand}" />
                    </StackPanel>
                    <ListView
                        Grid.Row="4"
                        ItemsSource="{Binding VisibleItems}"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        SelectionMode="Single"
                        Visibility="{Binding ShowLoginSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:VaultListItem">
                                <Grid ColumnSpacing="10" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <views:IdenticonStamp
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Top"
                                        Seed="{Binding IdenticonSeed}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{Binding Username}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{Binding KindAndFolder}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <GridView
                        Grid.Row="4"
                        ItemsSource="{Binding VisibleMedia}"
                        SelectedItem="{Binding SelectedMedia, Mode=TwoWay}"
                        SelectionMode="Single"
                        Visibility="{Binding ShowMediaPhotoGallery, Converter={StaticResource BoolToVisibilityConverter}}">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="136" ItemHeight="168" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MediaGalleryRow">
                                <Grid Width="124" Height="156">
                                    <Border
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <Grid>
                                            <FontIcon
                                                Glyph="{Binding Glyph}"
                                                FontSize="28"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <Image
                                                Stretch="UniformToFill"
                                                Source="{Binding Thumbnail}"
                                                Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <StackPanel
                                                VerticalAlignment="Bottom"
                                                Padding="6,4"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SizeLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <GridView
                        Grid.Row="4"
                        ItemsSource="{Binding VisibleMedia}"
                        SelectedItem="{Binding SelectedMedia, Mode=TwoWay}"
                        SelectionMode="Single"
                        Visibility="{Binding ShowMediaCardGallery, Converter={StaticResource BoolToVisibilityConverter}}">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="168" ItemHeight="120" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MediaGalleryRow">
                                <Border
                                    Width="156"
                                    Height="108"
                                    CornerRadius="8"
                                    Padding="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="22" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{Binding Title}"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="2" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Text="{Binding SizeLabel}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <ListView
                        Grid.Row="4"
                        ItemsSource="{Binding VisibleMedia}"
                        SelectedItem="{Binding SelectedMedia, Mode=TwoWay}"
                        SelectionMode="Single"
                        Visibility="{Binding ShowMediaFileExplorer, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.Header>
                            <Grid Padding="8,4,8,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.7*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [MediaExplorerName], Source={StaticResource Loc}}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding [MediaTagFilter], Source={StaticResource Loc}}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="{Binding [MediaExplorerDate], Source={StaticResource Loc}}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="3" Text="{Binding [MediaSize], Source={StaticResource Loc}}" FontWeight="SemiBold" FontSize="12" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MediaGalleryRow">
                                <Grid Padding="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="0.8*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="0.7*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TagOrUnfiled}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding DateLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <ListView
                        Grid.Row="4"
                        ItemsSource="{Binding VisibleAudit}"
                        SelectedItem="{Binding SelectedAudit, Mode=TwoWay}"
                        SelectionMode="Single"
                        Visibility="{Binding ShowAuditSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AuditRow">
                                <StackPanel Spacing="2" Padding="0,4">
                                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{Binding WhenLabel}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        Text="{Binding Detail}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer x:Name="VaultEditorPane" Grid.Column="1" Padding="24">
                <Grid>
                <StackPanel
                    Spacing="12"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding ShowLoginSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <views:IdenticonStamp
                            Width="40"
                            Height="40"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Seed="{Binding EditorIdenticonSeed}" />
                        <TextBlock Grid.Column="1" Text="{Binding [Item], Source={StaticResource Loc}}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="{Binding [LockVault], Source={StaticResource Loc}}"
                                Command="{Binding LockCommand}" />
                            <Button
                                Content="{Binding [PanicLock], Source={StaticResource Loc}}"
                                Command="{Binding PanicLockCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding CurrentPersonLabel}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UsageLine}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding PasswordAgeWarning}"
                        Style="{StaticResource CaptionTextStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasPasswordAgeWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ComboBox
                        x:Name="KindComboBox"
                        Header="{Binding [Type], Source={StaticResource Loc}}"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{Binding EditKindIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Name="KindLoginItem" Content="Login" />
                        <ComboBoxItem x:Name="KindAliasItem" Content="Hide-my-email alias" />
                        <ComboBoxItem x:Name="KindCardItem" Content="Credit card" />
                        <ComboBoxItem x:Name="KindNoteItem" Content="Note" />
                        <ComboBoxItem x:Name="KindIdentityItem" Content="Identity" />
                        <ComboBoxItem x:Name="KindRecoveryItem" Content="Recovery codes" />
                        <ComboBoxItem x:Name="KindWifiItem" Content="Wi-Fi" />
                        <ComboBoxItem x:Name="KindSecretItem" Content="API / .env" />
                    </ComboBox>
                    <TextBox Header="{Binding NameHeader}" PlaceholderText="{Binding NamePlaceholderText}" Text="{Binding EditTitle, Mode=TwoWay}" />
                    <ComboBox
                        Header="{Binding [ItemFolder], Source={StaticResource Loc}}"
                        HorizontalAlignment="Stretch"
                        IsEditable="True"
                        ItemsSource="{Binding FolderSuggestions}"
                        Text="{Binding EditFolder, Mode=TwoWay}" />
                    <TextBlock
                        Text="{Binding [FolderHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        Header="{Binding [MailboxProfile], Source={StaticResource Loc}}"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding MailboxProfiles}"
                        DisplayMemberPath="DisplayLabel"
                        SelectedItem="{Binding SelectedMailboxProfile, Mode=TwoWay}"
                        Visibility="{Binding ShowMailboxPicker, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBox
                        Header="{Binding [WebsiteOrApp], Source={StaticResource Loc}}"
                        PlaceholderText="{Binding [WebsitePlaceholder], Source={StaticResource Loc}}"
                        Text="{Binding EditUrl, Mode=TwoWay}"
                        Visibility="{Binding ShowLoginFields, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Grid
                        ColumnSpacing="8"
                        Visibility="{Binding ShowLoginFields, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="{Binding [UsernameOrEmail], Source={StaticResource Loc}}" Text="{Binding EditUsername, Mode=TwoWay}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Command="{Binding CopyUsernameCommand}"
                            ToolTipService.ToolTip="{Binding [CopyUsername], Source={StaticResource Loc}}"
                            Style="{StaticResource IconButtonStyle}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Grid
                        ColumnSpacing="8"
                        Visibility="{Binding ShowPasswordField, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Header="{Binding PasswordFieldHeader}"
                            FontFamily="Cascadia Mono, Consolas"
                            Text="{Binding EditPassword, Mode=TwoWay}"
                            Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <PasswordBox
                            x:Name="EditorPasswordBox"
                            Header="{Binding PasswordFieldHeader}"
                            FontFamily="Cascadia Mono, Consolas"
                            PasswordChanged="EditorPasswordBox_PasswordChanged"
                            Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            ToolTipService.ToolTip="{Binding PasswordRevealLabel}"
                            Style="{StaticResource IconButtonStyle}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE890;" FontSize="14" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Command="{Binding CopyPasswordCommand}"
                            ToolTipService.ToolTip="{Binding [CopyPassword], Source={StaticResource Loc}}"
                            Style="{StaticResource IconButtonStyle}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="14" />
                        </Button>
                    </Grid>
                    <StackPanel
                        Spacing="6"
                        Visibility="{Binding ShowPasswordHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding [PasswordHistory], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock
                            Text="{Binding [PasswordHistoryHint], Source={StaticResource Loc}}"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                        <ListView
                            ItemsSource="{Binding PasswordHistory}"
                            SelectionMode="None"
                            IsItemClickEnabled="False"
                            MaxHeight="180"
                            Visibility="{Binding HasPasswordHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PasswordHistoryRow">
                                    <Grid ColumnSpacing="8" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Text="{Binding Display}"
                                                FontFamily="Cascadia Mono, Consolas"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding WhenLabel}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding ToggleCommand}"
                                            ToolTipService.ToolTip="{Binding RevealLabel}"
                                            Style="{StaticResource IconButtonStyle}">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE890;" FontSize="14" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding CopyCommand}"
                                            ToolTipService.ToolTip="{Binding [CopyPassword], Source={StaticResource Loc}}"
                                            Style="{StaticResource IconButtonStyle}">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                        <Button
                                            Grid.Column="3"
                                            Command="{Binding RestoreCommand}"
                                            ToolTipService.ToolTip="{Binding [UsePreviousPassword], Source={StaticResource Loc}}"
                                            Style="{StaticResource IconButtonStyle}">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8FB;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{Binding ShowLoginFields, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox
                            Header="{Binding [TotpHeader], Source={StaticResource Loc}}"
                            Text="{Binding EditTotpSecret, Mode=TwoWay}"
                            FontFamily="Cascadia Mono, Consolas" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{Binding TotpDisplay}"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="22"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{Binding [CopyCode], Source={StaticResource Loc}}" Command="{Binding CopyTotpCommand}" />
                            <Button Grid.Column="2" Content="{Binding [NewSecret], Source={StaticResource Loc}}" Command="{Binding GenerateTotpCommand}" />
                        </Grid>
                        <Button Content="{Binding [AutofillFocused], Source={StaticResource Loc}}" Command="{Binding AutofillCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{Binding ShowAliasFields, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Header="{Binding [AliasEmail], Source={StaticResource Loc}}" Text="{Binding EditAliasEmail, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding [GenerateAlias], Source={StaticResource Loc}}" Command="{Binding GenerateAliasCommand}" />
                            <Button Content="{Binding [CopyAlias], Source={StaticResource Loc}}" Command="{Binding CopyAliasCommand}" />
                            <Button Content="{Binding [Compose], Source={StaticResource Loc}}" Command="{Binding ComposeAliasCommand}" />
                        </StackPanel>
                        <TextBlock
                            Text="{Binding [AliasHint], Source={StaticResource Loc}}"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{Binding ShowCardFields, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Header="{Binding [Cardholder], Source={StaticResource Loc}}" Text="{Binding EditCardholder, Mode=TwoWay}" />
                        <TextBox Header="{Binding [CardNumber], Source={StaticResource Loc}}" Text="{Binding EditCardNumber, Mode=TwoWay}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="{Binding [Expiry], Source={StaticResource Loc}}" PlaceholderText="12/28" Text="{Binding EditCardExpiry, Mode=TwoWay}" />
                            <TextBox Grid.Column="1" Header="{Binding [CVC], Source={StaticResource Loc}}" Text="{Binding EditCardCvv, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{Binding ShowIdentityFields, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Header="{Binding [FullName], Source={StaticResource Loc}}" Text="{Binding EditFullName, Mode=TwoWay}" />
                        <TextBox Header="{Binding [Phone], Source={StaticResource Loc}}" Text="{Binding EditPhone, Mode=TwoWay}" />
                        <TextBox Header="{Binding [Address], Source={StaticResource Loc}}" Text="{Binding EditAddress, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{Binding ShowRecoveryFields, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Header="{Binding [RecoveryRelated], Source={StaticResource Loc}}" PlaceholderText="{Binding [WebsitePlaceholder], Source={StaticResource Loc}}" Text="{Binding EditUrl, Mode=TwoWay}" />
                        <TextBlock
                            Text="{Binding [RecoveryHint], Source={StaticResource Loc}}"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                        <Button Content="{Binding [CopyRecoveryCodes], Source={StaticResource Loc}}" Command="{Binding CopyRecoveryCodesCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{Binding ShowWifiFields, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ComboBox
                            x:Name="WifiSecurityCombo"
                            Header="{Binding [WifiSecurity], Source={StaticResource Loc}}"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{Binding EditWifiSecurityIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Name="WifiWpaItem" Content="WPA / WPA2 / WPA3" />
                            <ComboBoxItem x:Name="WifiWepItem" Content="WEP" />
                            <ComboBoxItem x:Name="WifiOpenItem" Content="Open" />
                        </ComboBox>
                        <Image
                            Width="220"
                            Height="220"
                            HorizontalAlignment="Left"
                            Stretch="Uniform"
                            Source="{Binding WifiQrImage}"
                            Visibility="{Binding HasWifiQr, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            Text="{Binding [WifiQrHint], Source={StaticResource Loc}}"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{Binding ShowSecretFields, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox Header="{Binding [SecretHost], Source={StaticResource Loc}}" Text="{Binding EditUrl, Mode=TwoWay}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="{Binding [SecretUser], Source={StaticResource Loc}}" Text="{Binding EditUsername, Mode=TwoWay}" />
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{Binding CopyUsernameCommand}"
                                ToolTipService.ToolTip="{Binding [CopyUsername], Source={StaticResource Loc}}"
                                Style="{StaticResource IconButtonStyle}">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C8;" FontSize="14" />
                            </Button>
                        </Grid>
                        <TextBlock
                            Text="{Binding [SecretHint], Source={StaticResource Loc}}"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox Header="{Binding NotesHeader}" AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" Text="{Binding EditNotes, Mode=TwoWay}" />
                    <TextBlock Text="{Binding [Attachments], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock
                        Text="{Binding [DropToSealHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <ListView ItemsSource="{Binding AttachmentNames}" MaxHeight="90" />
                    <Button Content="{Binding [AttachFile], Source={StaticResource Loc}}" Command="{Binding AddAttachmentCommand}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding [Save], Source={StaticResource Loc}}" Style="{ThemeResource AccentButtonStyle}" MinHeight="40" Command="{Binding SaveItemCommand}" />
                        <Button Content="{Binding [Delete], Source={StaticResource Loc}}" Command="{Binding DeleteItemCommand}" MinHeight="40" />
                        <Button Content="{Binding [ShareItem], Source={StaticResource Loc}}" Command="{Binding ShareItemCommand}" MinHeight="40" />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding [EditorHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                    Spacing="12"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding ShowMediaEditor, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding MediaGalleryTitle}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding [LockVault], Source={StaticResource Loc}}" Command="{Binding LockCommand}" />
                            <Button Content="{Binding [PanicLock], Source={StaticResource Loc}}" Command="{Binding PanicLockCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding CurrentPersonLabel}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UsageLine}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding [MediaHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <TextBox Header="{Binding [MediaTitle], Source={StaticResource Loc}}" Text="{Binding EditMediaTitle, Mode=TwoWay}" />
                    <ComboBox
                        Header="{Binding FolderFilterHeader}"
                        HorizontalAlignment="Stretch"
                        IsEditable="True"
                        ItemsSource="{Binding FolderSuggestions}"
                        Text="{Binding EditFolder, Mode=TwoWay}" />
                    <TextBlock
                        Text="{Binding [MediaTagHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [MediaOriginal], Source={StaticResource Loc}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MediaOriginalName}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [MediaType], Source={StaticResource Loc}}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding MediaTypeLabel}" />
                    <TextBlock Text="{Binding [MediaSize], Source={StaticResource Loc}}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding MediaSizeLabel}" />
                    <Image
                        MaxHeight="280"
                        HorizontalAlignment="Left"
                        Stretch="Uniform"
                        Source="{Binding MediaPreview}"
                        Visibility="{Binding HasMediaPreview, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock
                        Text="{Binding [MediaPreviewHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding [Save], Source={StaticResource Loc}}" Style="{ThemeResource AccentButtonStyle}" MinHeight="40" Command="{Binding SaveMediaCommand}" />
                        <Button Content="{Binding [MediaExport], Source={StaticResource Loc}}" Command="{Binding ExportMediaCommand}" MinHeight="40" />
                        <Button Content="{Binding [Delete], Source={StaticResource Loc}}" Command="{Binding DeleteItemCommand}" MinHeight="40" />
                    </StackPanel>
                    <ProgressRing IsActive="{Binding IsBusy}" Width="28" Height="28" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel
                    Spacing="12"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding ShowAuditSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [VaultSectionActivity], Source={StaticResource Loc}}" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding [LockVault], Source={StaticResource Loc}}" Command="{Binding LockCommand}" />
                            <Button Content="{Binding [PanicLock], Source={StaticResource Loc}}" Command="{Binding PanicLockCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding CurrentPersonLabel}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding [AuditHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding SelectedAudit.Headline}"
                        Style="{StaticResource CardTitleStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding SelectedAudit.WhenLabel}"
                        Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock
                        Text="{Binding SelectedAudit.Detail}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding [AuditEmpty], Source={StaticResource Loc}}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasSelectedAudit, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                </StackPanel>
                </Grid>
            </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
