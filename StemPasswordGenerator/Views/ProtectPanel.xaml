<UserControl
    x:Class="StemPasswordGenerator.Views.ProtectPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:StemPasswordGenerator.Views"
    xmlns:models="using:StemPasswordGenerator.Models">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <views:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
    </UserControl.Resources>

    <Grid>
        <TextBlock
            Margin="28,20"
            Text="{Binding [ProtectLocked], Source={StaticResource Loc}}"
            Style="{StaticResource SecondaryTextStyle}"
            Visibility="{Binding ShowWorkspace, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
        <ScrollViewer
            views:FluidPage.Enable="True"
            Padding="24,18,28,24"
            Visibility="{Binding ShowWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="8" MaxWidth="{StaticResource ReadableTextWidth}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding [ProtectTitle], Source={StaticResource Loc}}" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock
                Text="{Binding [ProtectIntro], Source={StaticResource Loc}}"
                Style="{StaticResource SecondaryTextStyle}"
                TextWrapping="Wrap" />
            </StackPanel>
            <views:FluidCardPanel Grid.Row="1" MinColumnWidth="360" MaxColumns="3" ColumnSpacing="16" RowSpacing="16">

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [SecurityCenter], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding HealthSummary}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ClockStatus}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <ListView ItemsSource="{Binding HealthFindings}" MaxHeight="280">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:HealthFinding">
                                <StackPanel Spacing="2" Padding="0,6">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SeverityLabel}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [PeopleOnPc], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding PeopleWarning}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SwitchWarning}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CurrentPersonLabel}" FontWeight="SemiBold" />
                    <TextBlock
                        Text="{Binding [ProtectSwitchPeople], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <ListView ItemsSource="{Binding Occupants}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="180">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:VaultOccupant">
                                <TextBlock Text="{Binding DisplayName}" Padding="0,6" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="{Binding [AddAnotherPerson], Source={StaticResource Loc}}" PlaceholderText="{Binding [PartnerRoommate], Source={StaticResource Loc}}" Text="{Binding NewPersonName, Mode=TwoWay}" />
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="{Binding [Add], Source={StaticResource Loc}}" Command="{Binding AddPersonCommand}" />
                    </Grid>
                    <Button Content="{Binding [RemovePerson], Source={StaticResource Loc}}" Command="{Binding RemovePersonCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [MailboxProfiles], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding MailboxWarning}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    <ListView ItemsSource="{Binding MailboxProfiles}" SelectedItem="{Binding SelectedMailboxProfile, Mode=TwoWay}" MaxHeight="180">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MailboxProfile">
                                <StackPanel Spacing="2" Padding="0,6">
                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Email}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBox Header="{Binding [Label], Source={StaticResource Loc}}" PlaceholderText="{Binding [LabelPlaceholder], Source={StaticResource Loc}}" Text="{Binding NewMailboxLabel, Mode=TwoWay}" />
                    <TextBox Header="{Binding [Email], Source={StaticResource Loc}}" PlaceholderText="you@gmail.com" Text="{Binding NewMailboxEmail, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{Binding [AddMailbox], Source={StaticResource Loc}}" Command="{Binding AddMailboxCommand}" />
                        <Button Content="{Binding [MakeDefault], Source={StaticResource Loc}}" Command="{Binding MakeDefaultMailboxCommand}" />
                        <Button Content="{Binding [RemoveMailbox], Source={StaticResource Loc}}" Command="{Binding RemoveMailboxCommand}" />
                    </StackPanel>
                    <TextBox Header="{Binding [CustomAliasDomain], Source={StaticResource Loc}}" PlaceholderText="alias.mydomain.com" Text="{Binding AliasDomain, Mode=TwoWay}" />
                    <Button Content="{Binding [SaveAliasDomain], Source={StaticResource Loc}}" Command="{Binding SaveSettingsCommand}" />
                    <Button Content="{Binding [CreateNewAlias], Source={StaticResource Loc}}" Command="{Binding GenerateAliasCommand}" />
                    <TextBlock
                        Text="{Binding [AliasUnlimitedHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [CsvImportTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <InfoBar
                        IsOpen="True"
                        Severity="Error"
                        IsClosable="False"
                        Title="{Binding [CsvImportWarningTitle], Source={StaticResource Loc}}"
                        Message="{Binding [CsvImportWarning], Source={StaticResource Loc}}" />
                    <TextBlock
                        Text="{Binding [CsvImportHow], Source={StaticResource Loc}}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                    <Button
                        Content="{Binding [CsvImportButton], Source={StaticResource Loc}}"
                        Command="{Binding ImportCsvCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        MinHeight="44" />
                    <Button
                        Content="{Binding [CsvExportButton], Source={StaticResource Loc}}"
                        Command="{Binding ExportCsvCommand}"
                        HorizontalAlignment="Stretch"
                        MinHeight="44" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [SharingTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <InfoBar
                        IsOpen="True"
                        Severity="Warning"
                        IsClosable="False"
                        Title="{Binding [ShamirPrintTitle], Source={StaticResource Loc}}"
                        Message="{Binding [ShamirPrintHint], Source={StaticResource Loc}}" />
                    <Button
                        Content="{Binding [ShamirPrintButton], Source={StaticResource Loc}}"
                        Command="{Binding CreateShamirCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        MinHeight="44" />
                    <Button Content="{Binding [ShareVaultCopy], Source={StaticResource Loc}}" Command="{Binding ShareVaultCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="{Binding [ImportShare], Source={StaticResource Loc}}" Command="{Binding ImportShareCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="{Binding [PortableExportButton], Source={StaticResource Loc}}" Command="{Binding ExportPortableCommand}" HorizontalAlignment="Stretch" />
                    <TextBlock
                        Text="{Binding [PortableExportHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <Button Content="{Binding [CreateEmergencyKit], Source={StaticResource Loc}}" Command="{Binding EmergencyKitCommand}" HorizontalAlignment="Stretch" />
                    <TextBlock
                        Text="{Binding [DropToSealProtect], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding [SharingHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [DecoyVault], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding PanicWarning}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [PanicLockShortcut], Source={StaticResource Loc}}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{Binding DecoyStatusText}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <CheckBox
                        Content="{Binding [OpenDecoyOnPanic], Source={StaticResource Loc}}"
                        Style="{StaticResource OptionCheckBoxStyle}"
                        IsChecked="{Binding OpenDecoyOnPanic, Mode=TwoWay}" />
                    <Button Content="{Binding [PanicLock], Source={StaticResource Loc}}" Command="{Binding PanicLockCommand}" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" MinHeight="44" />
                    <Button Content="{Binding [CreateDecoyVault], Source={StaticResource Loc}}" Command="{Binding CreateDecoyCommand}" HorizontalAlignment="Stretch" Visibility="{Binding DecoyExists, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <Button Content="{Binding [ReplaceDecoyVault], Source={StaticResource Loc}}" Command="{Binding CreateDecoyCommand}" HorizontalAlignment="Stretch" Visibility="{Binding DecoyExists, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="{Binding [EditDecoyVault], Source={StaticResource Loc}}" Command="{Binding EditDecoyCommand}" HorizontalAlignment="Stretch" Visibility="{Binding DecoyExists, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="{Binding [RemoveDecoyVault], Source={StaticResource Loc}}" Command="{Binding RemoveDecoyCommand}" HorizontalAlignment="Stretch" Visibility="{Binding DecoyExists, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Content="{Binding [DoneEditingDecoy], Source={StaticResource Loc}}" Command="{Binding DoneEditingDecoyCommand}" HorizontalAlignment="Stretch" Visibility="{Binding ShowDecoyBanner, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [ChangeMasterTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <InfoBar
                        IsOpen="{Binding MasterRotationOverdue, Mode=OneWay}"
                        Severity="Error"
                        IsClosable="False"
                        Title="{Binding [MasterRotationDueTitle], Source={StaticResource Loc}}"
                        Message="{Binding [MasterRotationStatusOverdue], Source={StaticResource Loc}}" />
                    <InfoBar
                        IsOpen="{Binding MasterRotationSoon, Mode=OneWay}"
                        Severity="Warning"
                        IsClosable="False"
                        Title="{Binding [ChangeMasterTitle], Source={StaticResource Loc}}"
                        Message="{Binding MasterRotationStatus}" />
                    <TextBlock
                        Text="{Binding [ChangeMasterHow], Source={StaticResource Loc}}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding MasterRotationStatus}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <Button
                        Content="{Binding [ChangeMasterButton], Source={StaticResource Loc}}"
                        Command="{Binding ChangeMasterCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        MinHeight="44" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [RecoveryProtectTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding [RecoveryProtectHint], Source={StaticResource Loc}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RecoveryStatus}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    <Button
                        Content="{Binding [RecoveryCreate], Source={StaticResource Loc}}"
                        Command="{Binding SetupRecoveryCommand}"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding RecoveryConfigured, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <Button
                        Content="{Binding [RecoveryReplace], Source={StaticResource Loc}}"
                        Command="{Binding SetupRecoveryCommand}"
                        HorizontalAlignment="Stretch"
                        Visibility="{Binding RecoveryConfigured, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [AdvancedProtection], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding HelloWarning}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <Button Content="{Binding [EnableHello], Source={StaticResource Loc}}" Command="{Binding EnableHelloCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="{Binding [AutofillFocusedLogin], Source={StaticResource Loc}}" Command="{Binding AutofillCommand}" HorizontalAlignment="Stretch" />
                    <TextBlock
                        Text="{Binding AutofillHint}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            </views:FluidCardPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</UserControl>
