<UserControl
    x:Class="StemPasswordGenerator.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:StemPasswordGenerator.Views">

    <ScrollViewer
        views:FluidPage.Enable="True"
        Padding="24,18,28,24"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="8" MaxWidth="{StaticResource ReadableTextWidth}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding [SettingsTitle], Source={StaticResource Loc}}" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock
                    Text="{Binding [SettingsIntro], Source={StaticResource Loc}}"
                    Style="{StaticResource SecondaryTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <views:FluidCardPanel Grid.Row="1" MinColumnWidth="360" MaxColumns="3" ColumnSpacing="16" RowSpacing="16">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [Language], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <ComboBox
                        Header="{Binding [Language], Source={StaticResource Loc}}"
                        MinWidth="220"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="English" />
                        <ComboBoxItem Content="Español" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [Appearance], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton Content="{Binding [ThemeSystem], Source={StaticResource Loc}}" GroupName="Theme" MinHeight="40" IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                        <RadioButton Content="{Binding [ThemeLight], Source={StaticResource Loc}}" GroupName="Theme" MinHeight="40" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                        <RadioButton Content="{Binding [ThemeDark], Source={StaticResource Loc}}" GroupName="Theme" MinHeight="40" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [SettingsBehavior], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <CheckBox
                        Content="{Binding [ClearClipboard], Source={StaticResource Loc}}"
                        Style="{StaticResource OptionCheckBoxStyle}"
                        IsChecked="{Binding ClearClipboardAfterCopy, Mode=TwoWay}" />
                    <CheckBox
                        Content="{Binding [AutoLockVault], Source={StaticResource Loc}}"
                        Style="{StaticResource OptionCheckBoxStyle}"
                        IsChecked="{Binding AutoLockVault, Mode=TwoWay}" />
                    <CheckBox
                        Content="{Binding [StudentModeToggle], Source={StaticResource Loc}}"
                        Style="{StaticResource OptionCheckBoxStyle}"
                        IsChecked="{Binding StudentMode, Mode=TwoWay}" />
                    <TextBlock
                        Text="{Binding [StudentModeHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [TrayAndShortcuts], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock
                        Text="{Binding [TrayShortcutsHint], Source={StaticResource Loc}}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                    <CheckBox
                        Content="{Binding [StayInTray], Source={StaticResource Loc}}"
                        Style="{StaticResource OptionCheckBoxStyle}"
                        IsChecked="{Binding StayInTray, Mode=TwoWay}" />
                    <CheckBox
                        Content="{Binding [GlobalHotkeys], Source={StaticResource Loc}}"
                        Style="{StaticResource OptionCheckBoxStyle}"
                        IsChecked="{Binding GlobalHotkeys, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [PanicLock], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock
                        Text="{Binding [WarnPanicForensics], Source={StaticResource Loc}}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding [PanicLockShortcut], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock
                        Text="{Binding [PanicSetupHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [ResetAppTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock
                        Text="{Binding [ResetAppIntro], Source={StaticResource Loc}}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding [ResetAppHint], Source={StaticResource Loc}}"
                        Style="{StaticResource CaptionTextStyle}"
                        TextWrapping="Wrap" />
                    <Button
                        Content="{Binding [ResetAppButton], Source={StaticResource Loc}}"
                        Command="{Binding ResetAppDataCommand}"
                        HorizontalAlignment="Stretch"
                        MinHeight="44" />
                </StackPanel>
            </Border>
            </views:FluidCardPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
