<UserControl
    x:Class="StemPasswordGenerator.Views.AboutPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:StemPasswordGenerator.Views">

    <ScrollViewer
        views:FluidPage.Enable="True"
        Padding="24,18,28,24"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="8" MaxWidth="{StaticResource ReadableTextWidth}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding [About], Source={StaticResource Loc}}" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock
                    Text="{Binding [AboutAndAppInfo], Source={StaticResource Loc}}"
                    Style="{StaticResource SecondaryTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <views:FluidCardPanel Grid.Row="1" MinColumnWidth="360" MaxColumns="3" ColumnSpacing="16" RowSpacing="16">
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Image
                            Width="64"
                            Height="64"
                            HorizontalAlignment="Left"
                            Source="ms-appx:///Assets/Square150x150Logo.png" />
                        <TextBlock
                            Text="{Binding [AppTitle], Source={StaticResource Loc}}"
                            Style="{StaticResource SectionTitleStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="VersionLabel"
                            Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock
                            Text="{Binding [PublisherStem], Source={StaticResource Loc}}"
                            Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock
                            Text="{Binding [AboutCopyright], Source={StaticResource Loc}}"
                            Style="{StaticResource CaptionTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding [AboutWhatTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock
                            Text="{Binding [AboutBody1], Source={StaticResource Loc}}"
                            Style="{StaticResource SecondaryTextStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{Binding [AboutBody2], Source={StaticResource Loc}}"
                            Style="{StaticResource SecondaryTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding [Privacy], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock
                            Text="{Binding [PrivacyBody], Source={StaticResource Loc}}"
                            Style="{StaticResource SecondaryTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </views:FluidCardPanel>

            <StackPanel Grid.Row="2" Spacing="12">
                <StackPanel Spacing="8" MaxWidth="{StaticResource ReadableTextWidth}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding [AboutToolsTitle], Source={StaticResource Loc}}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock
                        Text="{Binding [AboutToolsIntro], Source={StaticResource Loc}}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <views:FluidCardPanel MinColumnWidth="360" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [AboutToolGenerateTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding [AboutToolGenerateBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [AboutToolCheckTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding [AboutToolCheckBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [AboutToolCipherTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding [AboutToolCipherBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [AboutToolVaultTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding [AboutToolVaultBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [AboutToolProtectTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding [AboutToolProtectBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [AboutToolUsbTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding [AboutToolUsbBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding [AboutToolSettingsTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="{Binding [AboutToolSettingsBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </views:FluidCardPanel>
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="12">
                <StackPanel Spacing="8" MaxWidth="{StaticResource ReadableTextWidth}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding [AboutGuidesTitle], Source={StaticResource Loc}}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock
                        Text="{Binding [AboutGuidesIntro], Source={StaticResource Loc}}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <Expander Header="{Binding [AboutGuideGenerateTitle], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutGuideGenerateBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutGuideCheckTitle], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutGuideCheckBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutGuideCipherTitle], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutGuideCipherBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutGuideVaultTitle], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutGuideVaultBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutGuideProtectTitle], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutGuideProtectBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutGuideUsbTitle], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutGuideUsbBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutGuideSettingsTitle], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutGuideSettingsBody], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="4" Spacing="12">
                <StackPanel Spacing="8" MaxWidth="{StaticResource ReadableTextWidth}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding [AboutFaqTitle], Source={StaticResource Loc}}" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock
                        Text="{Binding [AboutFaqIntro], Source={StaticResource Loc}}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <Expander Header="{Binding [AboutFaqCloudQ], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutFaqCloudA], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutFaqForgetQ], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutFaqForgetA], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutFaqHumanQ], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutFaqHumanA], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutFaqUsbQ], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutFaqUsbA], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutFaqCheckQ], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutFaqCheckA], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutFaqCipherQ], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutFaqCipherA], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutFaqOtherPcQ], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutFaqOtherPcA], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutFaqPanicQ], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutFaqPanicA], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutFaqMediaQ], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutFaqMediaA], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutFaqCaptureQ], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutFaqCaptureA], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutFaqHelloQ], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutFaqHelloA], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                        <Expander Header="{Binding [AboutFaqPeopleQ], Source={StaticResource Loc}}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <TextBlock Text="{Binding [AboutFaqPeopleA], Source={StaticResource Loc}}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
