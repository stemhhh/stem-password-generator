<UserControl
    x:Class="StemPasswordGenerator.Views.UsbKeyPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:StemPasswordGenerator.Views"
    xmlns:models="using:StemPasswordGenerator.Models"
    Loaded="OnLoaded">

    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <views:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
    </UserControl.Resources>

    <ScrollViewer views:FluidPage.Enable="True" Padding="24,18,28,24">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="8" MaxWidth="{StaticResource ReadableTextWidth}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding [UsbKeyTitle], Source={StaticResource Loc}}" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock
                Text="{Binding [UsbKeyIntro], Source={StaticResource Loc}}"
                Style="{StaticResource SecondaryTextStyle}"
                TextWrapping="Wrap" />
            </StackPanel>
            <views:FluidCardPanel Grid.Row="1" MinColumnWidth="360" MaxColumns="3" ColumnSpacing="16" RowSpacing="16">

            <InfoBar
                IsOpen="True"
                Severity="Warning"
                IsClosable="False"
                Title="{Binding [UsbNotFidoTitle], Source={StaticResource Loc}}"
                Message="{Binding [UsbNotFidoBody], Source={StaticResource Loc}}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [UsbPickDrive], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock Text="{Binding UsbHint}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <ListView
                        ItemsSource="{Binding UsbDrives}"
                        SelectedItem="{Binding SelectedUsbDrive, Mode=TwoWay}"
                        MaxHeight="180">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:UsbDriveInfo">
                                <TextBlock Text="{Binding DisplayLabel}" Padding="0,6" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button
                        Content="{Binding [UsbRefresh], Source={StaticResource Loc}}"
                        Command="{Binding RefreshUsbDrivesCommand}"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [UsbFormatOptions], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock
                        Text="{Binding [UsbFormatHint], Source={StaticResource Loc}}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                    <ComboBox
                        Header="{Binding [UsbFileSystem], Source={StaticResource Loc}}"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{Binding UsbFileSystemIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="exFAT" />
                        <ComboBoxItem Content="FAT32" />
                        <ComboBoxItem Content="NTFS" />
                    </ComboBox>
                    <ComboBox
                        Header="{Binding [UsbAllocation], Source={StaticResource Loc}}"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{Binding UsbClusterIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{Binding [UsbClusterDefault], Source={StaticResource Loc}}" />
                        <ComboBoxItem Content="4096" />
                        <ComboBoxItem Content="8192" />
                        <ComboBoxItem Content="16384" />
                        <ComboBoxItem Content="32768" />
                        <ComboBoxItem Content="65536" />
                    </ComboBox>
                    <TextBox
                        Header="{Binding [UsbVolumeLabel], Source={StaticResource Loc}}"
                        Text="{Binding UsbVolumeLabel, Mode=TwoWay}" />
                    <CheckBox
                        Content="{Binding [UsbQuickFormat], Source={StaticResource Loc}}"
                        Style="{StaticResource OptionCheckBoxStyle}"
                        IsChecked="{Binding UsbQuickFormat, Mode=TwoWay}" />
                    <CheckBox
                        Content="{Binding [UsbFormatFirst], Source={StaticResource Loc}}"
                        Style="{StaticResource OptionCheckBoxStyle}"
                        IsChecked="{Binding UsbFormatFirst, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [UsbPrepareTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock
                        Text="{Binding [UsbPrepareHint], Source={StaticResource Loc}}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                    <Button
                        Content="{Binding [UsbPrepareButton], Source={StaticResource Loc}}"
                        Command="{Binding PrepareUsbKeyCommand}"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        MinHeight="44" />
                    <Button
                        Content="{Binding [UsbRemoveButton], Source={StaticResource Loc}}"
                        Command="{Binding RemoveUsbUnlockCommand}"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding [UsbRestoreTitle], Source={StaticResource Loc}}" Style="{StaticResource CardTitleStyle}" />
                    <TextBlock
                        Text="{Binding [UsbRestoreHint], Source={StaticResource Loc}}"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                    <Button
                        Content="{Binding [UsbRestoreButton], Source={StaticResource Loc}}"
                        Command="{Binding RestoreUsbStorageCommand}"
                        HorizontalAlignment="Stretch"
                        MinHeight="44" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
            </views:FluidCardPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
